# Local HTTP development only. Generate your own key before starting.
DJANGO_SECRET_KEY=replace-with-a-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:8080
# DATABASE_PATH=/absolute/writable/path/db.sqlite3
# TRUST_PROXY=false
# Supply a key only after independent code review. Leave both empty for other APIs.
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.8-flash
WHISPER_MODEL=base
# WHISPER_CACHE_DIR=/absolute/writable/model-cache
WHISPER_CPU_THREADS=2
GENERATION_TIMEOUT=900
MAX_VIDEO_SECONDS=900
MAX_DOWNLOAD_BYTES=100000000
MAX_TRANSCRIPT_CHARS=120000
DOWNLOAD_TIMEOUT=120
AUDIO_TIMEOUT=120
GEMINI_TIMEOUT=60
# GENERATION_TEMP_DIR=/absolute/writable/temp
# GENERATION_LOCK_PATH=/absolute/writable/shared/generation.lock
